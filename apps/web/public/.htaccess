# Redirige todas las rutas que no sean archivos reales hacia index.html,
# para que React Router (/admin, /checkout, /product/:id, etc.) funcione
# incluso al recargar la página o entrar directo por URL.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo o carpeta solicitado existe de verdad, sírvelo tal cual
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Si no, entrega index.html y deja que React Router decida qué mostrar
  RewriteRule ^ index.html [L]
</IfModule>

# Cache básico para archivos estáticos compilados
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# ============================================================
# Encabezados de seguridad HTTP
# ============================================================
<IfModule mod_headers.c>
  # Evita que el sitio se cargue dentro de un <iframe> ajeno (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Evita que el navegador "adivine" el tipo de archivo (protege contra XSS)
  Header always set X-Content-Type-Options "nosniff"

  # No envía la URL completa como referrer a otros sitios
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Fuerza HTTPS en el navegador durante 2 años (quita esto si aún dudas de tu SSL)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Aísla el sitio de otras pestañas/ventanas (protege contra ciertos ataques de canal lateral)
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Desactiva permisos del navegador que este sitio no usa
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Política de Seguridad de Contenido (CSP): limita de dónde puede cargar
  # scripts, estilos, imágenes y llamadas de red este sitio.
  # Si conectas otro dominio nuevo (otro Supabase, otro webhook de n8n,
  # otra fuente de imágenes), agrégalo en connect-src o img-src, si no,
  # el navegador lo bloqueará silenciosamente.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://*.supabase.in; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
</IfModule>

