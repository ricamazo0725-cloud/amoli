# Copia este archivo como ".env" en esta misma carpeta (apps/web-next/.env)
# y reemplaza los valores con los de tu proyecto de Supabase / Google Maps / n8n.
# OJO: estas variables se incrustan en el código DURANTE EL BUILD (next build),
# no al arrancar el proceso — si las cambias, hay que volver a compilar (no
# alcanza con solo reiniciar el proceso en Hostinger).

NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-api-key-aqui
NEXT_PUBLIC_N8N_WEBHOOK_URL=
