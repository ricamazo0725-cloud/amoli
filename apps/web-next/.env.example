# Copia este archivo como ".env" en esta misma carpeta (apps/web-next/.env)
# y reemplaza los valores con los de tu proyecto de Supabase / Google Maps / n8n.
# OJO: estas variables se incrustan en el código DURANTE EL BUILD (next build),
# no al arrancar el proceso — si las cambias, hay que volver a compilar (no
# alcanza con solo reiniciar el proceso en Hostinger).

NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-api-key-aqui
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# --- Verificación de WhatsApp en el checkout (código de 6 dígitos) ---
# Estas dos NO llevan NEXT_PUBLIC_ a propósito: solo las usan las rutas del
# servidor (src/app/api/otp/*), nunca deben llegar al navegador.

# Supabase Dashboard → Project Settings → API → service_role key (secreta).
# Se usa para guardar/leer los códigos en la tabla phone_otps (ver
# apps/web-next/supabase/phone_otps.sql) sin pasar por RLS.
SUPABASE_SERVICE_ROLE_KEY=

# URL del webhook de n8n que dispara el envío del código por WhatsApp
# (workflow: nodo Webhook → nodo de Evolution API → enviar mensaje).
# Recibe un POST con { event: "otp.send", phone, code, expires_in_seconds }.
# Puede ser un webhook nuevo y distinto al de NEXT_PUBLIC_N8N_WEBHOOK_URL
# (ese sigue siendo para notificar pedidos ya creados).
N8N_OTP_WEBHOOK_URL=
