{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"setup": "pnpm install",
		"dev": "pnpm --filter ./apps/web dev",
		"build": "find node_modules -type f -path '*/bin/esbuild' -exec chmod +x {} \\; ; npm --prefix apps/web run build",
		"start": "npm --prefix apps/web run start",
		"lint": "pnpm --filter ./apps/web lint"
	},
	"dependencies": {
		"brace-expansion": "5.0.9",
		"esbuild": "0.28.1",
		"react-router": "8.3.0"
	}
}
